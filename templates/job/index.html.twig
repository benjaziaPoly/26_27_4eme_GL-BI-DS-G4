{% extends "template_job.html.twig" %}
{% block title %}
    {{ parent () }} - Liste des  jobs
{% endblock %}

{% block body %}
    <h3>Liste des Jobs</h3>
    <hr>
    {% if jobs | length > 0  %}
    <table class="table table-bordred">
        <thead>      <tr>
            <th> Type </th> 
            <th> Description </th> 
            <th> email </th>
            <th> company </th>
            <th> Date Expiration </th>
            <th> </th>
          </tr>
          </thead>
           {% for job in jobs %}
                 <tr>
                     <td> {{ job.getType }}</td>
                     <td>{{ job.getDescription }}</td>
                      <td> {{ job.getEmail }}</td>
                      <td> {{ job.getCompany }}</td>
                      <td>  {{ job.getExpiresAt | date("d-m-Y") }}</td>
                      <td> ...</td>
                 </tr>
           {% endfor %}
    </table>
    {% else %}
        <p class="text-danger">Aucune Job !!!</p>
        {% endif%}
{% endblock %}